def multiply(p1,p2):
    return p1*p2
print(multiply(2,3))# Output: 6
print(multiply(8, "r"))# Output: "rrrrrrrr"
print(multiply("a",5))# Output: "aaaaa"
print(multiply(5, "a"))# Output: "aaaaa"
print("Hi " * 3)# Output: "Hi Hi Hi "


print([1, 2] * 3)# Output: [1, 2, 1, 2, 1, 2]
print((1, 2) * 2)# Output: (1, 2, 1, 2)
print("Hi" * 0)# Output: ""


